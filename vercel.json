{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/scheduling", "destination": "/contact", "permanent": true },
    { "source": "/scheduling-old", "destination": "/contact", "permanent": true },
    { "source": "/book-appointments", "destination": "/contact", "permanent": true },
    { "source": "/sauce-slice", "destination": "/", "permanent": true },
    { "source": "/sofia-pazari", "destination": "/", "permanent": true },
    { "source": "/collette-noll", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
